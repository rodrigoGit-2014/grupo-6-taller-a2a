GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
# Respaldo opcional: sin DEEPSEEK_API_KEY todo funciona solo con Gemini.
# DEEPSEEK_API_KEY=
# MODELO_RESPALDO=deepseek-chat

# Agente expuesto por `langgraph dev` (lo usa el notebook).
# El assistant_id es un UUID que el servidor asigna al grafo: se obtiene con
# POST /assistants/search {"graph_id": ...}
# El taller corre dos agentes en paralelo: el primero en el puerto 2025 y el segundo en 2026.
A2A_URL=http://127.0.0.1:2025
A2A_GRAPH=agente_rodrigo
