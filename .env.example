GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
# Respaldo opcional: sin DEEPSEEK_API_KEY todo funciona solo con Gemini.
# DEEPSEEK_API_KEY=
# MODELO_RESPALDO=deepseek-chat

# ── Perfil 1 · Rodrigo ───────────────────────────────────────────────────────
# Servidor local obligatorio para el notebook (Rodrigo aporta desde 2025).
A2A_URL_1=http://127.0.0.1:2025
A2A_GRAPH_1=agente_rodrigo
A2A_NOMBRE_1=Rodrigo
# Vacío = se descubre con /assistants/search. Definido = se usa tal cual.
A2A_ASSISTANT_ID_1=
# 1 = el notebook actualiza su tarjeta antes de conversar.
A2A_GESTIONAR_TARJETA_1=1

# ── Perfil 2 · Christopher (local por defecto) ──────────────────────────────
A2A_URL_2=http://127.0.0.1:2026
A2A_GRAPH_2=agente_christopher
A2A_NOMBRE_2=Christopher
A2A_ASSISTANT_ID_2=
A2A_GESTIONAR_TARJETA_2=1

# ── Perfil 3 · Paulina (local por defecto) ──────────────────────────────────
A2A_URL_3=http://127.0.0.1:2027
A2A_GRAPH_3=agente_paulina
A2A_NOMBRE_3=Paulina
A2A_ASSISTANT_ID_3=
A2A_GESTIONAR_TARJETA_3=1
# Nombre visible de la tarjeta. Si se omite, Paulina publica "Agente Paulina".
# A2A_NOMBRE_TARJETA_3=Agente Paulina

# ── Perfiles remotos por Cloudflare (opcional) ──────────────────────────────
# Si un perfil corre en otra máquina, comenta su bloque local y descomenta el
# bloque remoto correspondiente. Solo necesitas tener arriba el servidor de
# Rodrigo. No modifiques la tarjeta de otra persona: usa GESTIONAR_TARJETA=0.
#
# Christopher remoto:
# A2A_URL_2=https://assume-setup-see-total.trycloudflare.com
# A2A_GRAPH_2=agente_christopher
# A2A_NOMBRE_2=Christopher
# A2A_ASSISTANT_ID_2=b71a76f3-1a4f-5263-a63d-b005bf9e46e1
# A2A_GESTIONAR_TARJETA_2=0
#
# Paulina remota:
# A2A_URL_3=https://<tu-tunel-de-paulina>.trycloudflare.com
# A2A_GRAPH_3=agente_paulina
# A2A_NOMBRE_3=Paulina
# A2A_ASSISTANT_ID_3=<uuid-de-paulina>
# A2A_GESTIONAR_TARJETA_3=0
#
# A2A_DESCRIPCION_2 y A2A_DESCRIPCION_3 son opcionales: si no las defines, el
# notebook usa las descripciones que ya trae escritas para el router.
